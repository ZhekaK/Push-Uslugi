    m_Font: {fileID: 12800000, guid: ad4d6b6b9a675b9499dd8633fd07eac2, type: 3}
    m_FontSize: 29
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "2) \u0421\u043E\u0431\u0435\u0440\u0438 4 \u0441\u0432\u043E\u0438\u0445
    \u0444\u0438\u0433\u0443\u0440\u044B \u043F\u043E\u0434\u0440\u044F\u0434: \u0432
    \u0441\u0442\u043E\u043B\u0431\u0438\u043A, \u0432 \u043B\u0438\u043D\u0438\u044E
    \u0438\u043B\u0438 \u043F\u043E \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438
    \u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0438 \u043F\u043E\u0431\u0435\u0434\u044B!
    \u0418\u0433\u0440\u0430\u0442\u044C \u043C\u043E\u0436\u043D\u043E \u0441 \u0434\u0440\u0443\u0433\u043E\u043C
    \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435
    \u0438\u043B\u0438 \u0441 \u0431\u043E\u0442\u043E\u043C."
