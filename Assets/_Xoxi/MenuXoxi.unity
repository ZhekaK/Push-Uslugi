    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "1) \u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u0442\u043E\u043B\u0431\u0438\u043A
    \u0438 \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043D\u0435\u0433\u043E.
    \u0422\u0430\u043A \u0442\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0448\u044C
    \u043A\u0440\u0435\u0441\u0442\u0438\u043A \u0438\u043B\u0438 \u043D\u043E\u043B\u0438\u043A.
    \u041F\u043E\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
    \u0432\u0441\u0435 \u0444\u0438\u0433\u0443\u0440\u044B \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
    \u0432\u043D\u0438\u0437!"
